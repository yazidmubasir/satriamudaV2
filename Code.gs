const APP = Object.freeze({name:'SATRIA Builder', version:'1.0.0', tokenTtl:21600, masterProp:'MASTER_SPREADSHEET_ID', bootProp:'BOOTSTRAPPED'});
const ROLES = ['owner','guru','karyawan','admin_kelas','siswa'];
const MASTER = {
  MASTER_USERS:['id_user','username','password_sha','nama','email','role','id_ref','nip_nisn','id_kelas','spreadsheet_id','status','created_at','updated_at'],
  MASTER_GURU:['id_guru','nip','nama','email','status'],
