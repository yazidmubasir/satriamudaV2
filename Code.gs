const SEED_MODULES = [
  ['MODUL-7KAIH','7KAIH','MODUL 7KAIH','Kegiatan pembiasaan dan penguatan karakter 7KAIH.','TRX_7KAIH',['tanggal','siswa_id','nama_siswa','kelas','indikator','uraian_kegiatan','catatan','bukti_fisik','created_at'],['siswa','admin_kelas','guru']],
  ['MODUL-BELAJAR','BELAJAR_MANDIRI','MODUL BELAJAR MANDIRI','Kegiatan belajar mandiri siswa per kelas.','TRX_BELAJAR_MANDIRI',['tanggal','siswa_id','nama_siswa','kelas','mata_pelajaran','materi','aktivitas','hasil_belajar','refleksi','bukti_fisik','created_at'],['siswa','admin_kelas','guru']],
  ['MODUL-LITERASI','LITERASI','MODUL KEGIATAN LITERASI','Pencatatan kegiatan literasi siswa.','TRX_LITERASI',['tanggal','siswa_id','nama_siswa','kelas','jenis_literasi','judul_bacaan','ringkasan','refleksi','bukti_fisik','created_at'],['siswa','admin_kelas','guru']]
